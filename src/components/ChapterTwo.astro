---
// ChapterTwo.astro
// The Hook: Loot boxes enter the picture. Design starts shifting darker.
---

<section class="chapter-two" id="chapter-2">
  <div class="parallax-layer" aria-hidden="true">
    <div class="loot-box lb-1">?</div>
    <div class="loot-box lb-2">?</div>
    <div class="loot-box lb-3">?</div>
    <div class="loot-box lb-4">?</div>
    <div class="loot-box lb-5">?</div>
  </div>

  <div class="content">
    <div class="chapter-label pixel-text">// CHAPTER 02</div>
    <h2 class="chapter-title">THE HOOK:<br /><em>LOOT BOXES</em></h2>

    <div class="stat-callout">
      <span class="stat-number">$15B</span>
      <span class="stat-label">generated by loot boxes globally in 2020</span>
    </div>

    <div class="essay-text">
      <p>
        <!-- TODO: Replace with your loot box section content -->
        Around 2016, the industry discovered something powerful: players would
        pay for <em>randomness</em>. Not for a guaranteed item, but for a
        <em>chance</em> at one. The loot box was born — and with it, the
        psychological architecture of a slot machine embedded inside games
        rated for children.
      </p>
      <p>
        <!-- TODO: Add your research on variable ratio reinforcement here -->
        Behavioral psychologists call it variable ratio reinforcement — the
        same mechanism that makes slot machines so difficult to walk away from.
        When rewards are unpredictable, the dopamine response is stronger.
        Game designers knew this. Publishers knew this.
      </p>
    </div>

    <div class="open-box-demo" aria-label="Loot box opening animation demo">
      <div class="box-container">
        <div class="box" id="demo-box">
          <div class="box-lid"></div>
          <div class="box-body">?</div>
        </div>
        <button class="open-btn pixel-text" onclick="openBox()">OPEN BOX</button>
        <div class="reward" id="box-reward" aria-live="polite"></div>
      </div>
    </div>
  </div>
</section>

<script>
  const rewards = ['⚔️ RARE SWORD', '🛡️ EPIC SHIELD', '💀 DUPLICATE', '💀 DUPLICATE', '💀 DUPLICATE', '💎 LEGENDARY?... DUPLICATE'];
  function openBox() {
    const box = document.getElementById('demo-box');
    const reward = document.getElementById('box-reward');
    const btn = document.querySelector('.open-btn');
    box?.classList.add('opening');
    btn && (btn.disabled = true);
    setTimeout(() => {
      const pick = rewards[Math.floor(Math.random() * rewards.length)];
      if (reward) reward.textContent = pick;
      box?.classList.remove('opening');
      btn && (btn.disabled = false);
    }, 800);
  }
  // Parallax on scroll
  window.addEventListener('scroll', () => {
    const layer = document.querySelector('.parallax-layer') as HTMLElement;
    if (layer) layer.style.transform = `translateY(${window.scrollY * 0.2}px)`;
  });
</script>

<style>
  .chapter-two {
    min-height: 100vh;
    background-color: var(--c2-bg);
    color: var(--c2-text);
    padding: var(--section-padding);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  /* Floating loot boxes (parallax layer) */
  .parallax-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    will-change: transform;
  }

  .loot-box {
    position: absolute;
    font-family: var(--font-pixel);
    font-size: 2rem;
    color: var(--c2-accent);
    background: rgba(233, 196, 106, 0.08);
    border: 2px solid rgba(233, 196, 106, 0.3);
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    animation: float-box 6s ease-in-out infinite;
  }

  .lb-1 { top: 10%;  left: 5%;   animation-delay: 0s; }
  .lb-2 { top: 30%;  right: 8%;  animation-delay: 1.5s; font-size: 1.2rem; }
  .lb-3 { top: 60%;  left: 80%;  animation-delay: 3s; }
  .lb-4 { top: 75%;  left: 2%;   animation-delay: 0.8s; font-size: 1.5rem; }
  .lb-5 { top: 20%;  left: 45%;  animation-delay: 2.2s; font-size: 2.5rem; }

  @keyframes float-box {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50%       { transform: translateY(-20px) rotate(3deg); }
  }

  .content { position: relative; z-index: 1; max-width: 800px; }

  .chapter-label {
    font-size: 0.6rem;
    color: var(--c2-accent);
    letter-spacing: 0.2em;
    margin-bottom: 1.5rem;
    opacity: 0.7;
  }

  .chapter-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 2.5rem;
  }

  .chapter-title em {
    color: var(--c2-accent);
    font-style: normal;
  }

  /* Stat callout */
  .stat-callout {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 2.5rem;
    border-left: 4px solid var(--c2-accent);
    padding-left: 1.5rem;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    color: var(--c2-accent);
  }

  .stat-label {
    font-size: 1rem;
    color: var(--c2-glow);
    max-width: 20ch;
  }

  .essay-text p {
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.9;
    margin-bottom: 1.5rem;
    color: var(--c2-text);
  }

  .essay-text em {
    color: var(--c2-accent);
    font-style: normal;
    font-weight: 700;
  }

  /* Loot box demo */
  .open-box-demo {
    margin-top: 3rem;
  }

  .box-container {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .box {
    width: 80px;
    height: 80px;
    position: relative;
    transition: transform 0.4s;
  }

  .box.opening { animation: shake 0.4s ease; }

  @keyframes shake {
    0%, 100% { transform: rotate(0deg); }
    25%       { transform: rotate(-8deg); }
    75%       { transform: rotate(8deg); }
  }

  .box-lid {
    width: 100%;
    height: 20px;
    background: var(--c2-accent);
    border-radius: 4px 4px 0 0;
    border: 2px solid #c49a20;
  }

  .box-body {
    width: 100%;
    height: 60px;
    background: #2a2a4e;
    border: 2px solid var(--c2-accent);
    border-top: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-pixel);
    font-size: 1.4rem;
    color: var(--c2-accent);
  }

  .open-btn {
    background: transparent;
    border: 2px solid var(--c2-accent);
    color: var(--c2-accent);
    padding: 0.8rem 1.5rem;
    font-size: 0.65rem;
    cursor: pointer;
    letter-spacing: 0.1em;
    transition: background 0.2s, color 0.2s;
  }

  .open-btn:hover:not(:disabled) {
    background: var(--c2-accent);
    color: var(--c2-bg);
  }

  .open-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  .reward {
    font-family: var(--font-pixel);
    font-size: 0.7rem;
    color: var(--c2-accent);
    min-width: 20ch;
    letter-spacing: 0.05em;
  }
</style>
