<style>
  .chapter-four {
    min-height: 100vh;
    background-color: var(--c4-bg);
    color: var(--c4-text);
    padding: var(--section-padding);
    display: flex;
    align-items: flex-start;
  }

  .content { max-width: 780px; }

  .chapter-label {
    font-size: 0.6rem;
    color: var(--c4-accent);
    letter-spacing: 0.2em;
    margin-bottom: 1.5rem;
    opacity: 0.7;
  }

  .chapter-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 800;
    margin-bottom: 1.5rem;
    line-height: 1;
    color: var(--c4-text);
  }

  .chapter-intro {
    font-size: 1.2rem;
    color: #555;
    margin-bottom: 3rem;
    font-style: italic;
    border-left: 4px solid var(--c4-accent);
    padding-left: 1.5rem;
  }

  /* Stats grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .stat-card {
    border: 1px solid #ddd;
    padding: 1.5rem;
    background: white;
  }

  .stat-num {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--c4-accent);
    margin-bottom: 0.5rem;
  }

  .stat-desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: #444;
  }

  cite {
    display: block;
    font-size: 0.75rem;
    color: #888;
    margin-top: 0.25rem;
    font-style: normal;
  }

  /* Essay body */
  .essay-body h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    margin: 2.5rem 0 1rem;
    color: var(--c4-text);
    border-bottom: 2px solid var(--c4-accent);
    padding-bottom: 0.4rem;
    display: inline-block;
  }

  .essay-body p {
    font-size: clamp(1rem, 2vw, 1.1rem);
    line-height: 1.9;
    margin-bottom: 1.5rem;
    color: #333;
  }

  /* Works cited */
  .works-cited {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid #ddd;
  }

  .works-cited h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }

  .works-cited ul {
    list-style: none;
    padding: 0;
  }

  .works-cited li {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #555;
    padding: 0.6rem 0;
    border-bottom: 1px solid #eee;
    font-family: var(--font-mono);
  }
</style>
