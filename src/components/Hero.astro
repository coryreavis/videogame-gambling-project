---
// Hero.astro — Full screen opening title card
import BouncingArrow from './BouncingArrow.astro';
import CRTTransition from './CRTTransition.astro';
---

<section class="hero crt" id="hero">

  <!-- CRT overlay layers -->
  <div class="scanlines" aria-hidden="true"></div>

  <!-- Binary/block scroll transition overlay -->
  <CRTTransition />

  <!-- Main content -->
  <div class="hero-content">
    <p class="hero-eyebrow pixel-text">A MULTIMODAL RESEARCH PROJECT</p>

    <h1 class="hero-title">
      <span class="line-1">THE TRUE COST</span>
      <span class="line-2">
        <span class="gaming-container">
          <span class="of-text">OF&nbsp;</span>
          <span class="word-gam">GAM</span>
          <span
            class="glitch-suffix"
            data-real="ING"
            data-fake="BLING"
          >ING</span>
        </span>
      </span>
    </h1>

    <p class="hero-subtitle">
      How are loot boxes and cosmetic gambling impacting the development of adolescent men?
    </p>

    <div class="hero-instructions">
      <span class="player-1">PLAYER 1</span>
      <span class="press-start">SCROLL TO CONTINUE</span>
      <span class="arrow">
        <BouncingArrow />
      </span>
    </div>
  </div>

</section>

<style>
  /* ---- Base hero ---- */
  .hero {
    min-height: 100vh;
    background: #0d0d0d;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    animation: crt-on 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
  }

    /* ---- Screen-door: stronger scanlines ---- */
  .hero::before {
    content: " ";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(18,16,16,0) 50%, rgba(0,0,0,0.22) 50%),
      linear-gradient(90deg, rgba(255,0,0,0.07), rgba(0,255,0,0.03), rgba(0,0,255,0.07));
    background-size: 100% 2px, 3px 100%;
    z-index: 2;
    pointer-events: none;
  }

  /* ---- Flicker: wider opacity swings ---- */
  @keyframes flicker {
    0%   { opacity: 0.08; }
    5%   { opacity: 0.14; }
    15%  { opacity: 0.18; }
    25%  { opacity: 0.05; }
    40%  { opacity: 0.12; }
    55%  { opacity: 0.06; }
    70%  { opacity: 0.15; }
    85%  { opacity: 0.09; }
    100% { opacity: 0.11; }
  }

  /* ---- Color separation: larger offsets ---- */
  @keyframes textShadow {
    0%   { text-shadow: 1.2px  0 1px rgba(0,30,255,0.45), -1.2px  0 1px rgba(255,0,80,0.35), 0 0 4px; }
    20%  { text-shadow: 5.5px  0 1px rgba(0,30,255,0.45), -5.5px  0 1px rgba(255,0,80,0.35), 0 0 4px; }
    40%  { text-shadow: 6.2px  0 1px rgba(0,30,255,0.45), -6.2px  0 1px rgba(255,0,80,0.35), 0 0 4px; }
    60%  { text-shadow: 3.8px  0 1px rgba(0,30,255,0.45), -3.8px  0 1px rgba(255,0,80,0.35), 0 0 4px; }
    80%  { text-shadow: 1.8px  0 1px rgba(0,30,255,0.45), -1.8px  0 1px rgba(255,0,80,0.35), 0 0 4px; }
    100% { text-shadow: 4.4px  0 1px rgba(0,30,255,0.45), -4.4px  0 1px rgba(255,0,80,0.35), 0 0 4px; }
  }

  /* ---- Scanlines ---- */
  .scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.15) 2px,
      rgba(0, 0, 0, 0.15) 4px
    );
    pointer-events: none;
    z-index: 1;
  }

  /* ---- Hero content ---- */
  .hero-content {
    position: relative;
    z-index: 3; /* sits above ::before, ::after, and CRTTransition canvas */
    text-align: center;
    padding: 2rem;
    animation: fadeUp 1.2s ease both, textShadow 1.6s infinite;
  }

  /* ---- Title ---- */
  .hero-title {
    display: flex;
    flex-direction: column;
    gap: 0;
    line-height: 0.9;
    margin-bottom: 1.5rem;
  }

  .line-1 {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 800;
    color: white;
    display: block;
    animation: fadeUp 1.2s ease 0.3s both;
  }

  .line-2 {
    font-family: 'Science Gothic', sans-serif;
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 800;
    color: transparent;
    -webkit-text-stroke: 2px #15ff00;
    display: block;
    animation: fadeUp 1.2s ease 0.45s both;
    text-shadow: 0 0 40px rgba(30, 255, 0, 0.3);
  }

  .gaming-container {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    width: 100%;
  }

  .of-text {
    text-align: right;
  }

  /* ---- Glitch suffix ---- */
  .glitch-suffix {
    position: relative;
    display: inline-block;
    text-align: left;
  }

  .glitch-suffix.is-glitching::before,
  .glitch-suffix.is-glitching::after {
    content: attr(data-current);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .glitch-suffix.is-glitching::before {
    color: #ff003c;
    transform: translate(-3px, 1px);
    clip-path: polygon(0 20%, 100% 20%, 100% 40%, 0 40%);
    animation: glitch-clip 0.15s steps(1) infinite;
  }

  .glitch-suffix.is-glitching::after {
    color: #00fff9;
    transform: translate(3px, -1px);
    clip-path: polygon(0 60%, 100% 60%, 100% 80%, 0 80%);
    animation: glitch-clip 0.15s steps(1) infinite reverse;
  }

  @keyframes glitch-clip {
    0%   { clip-path: polygon(0 0%,   100% 0%,   100% 20%, 0 20%); }
    25%  { clip-path: polygon(0 40%,  100% 40%,  100% 55%, 0 55%); }
    50%  { clip-path: polygon(0 65%,  100% 65%,  100% 80%, 0 80%); }
    75%  { clip-path: polygon(0 10%,  100% 10%,  100% 30%, 0 30%); }
    100% { clip-path: polygon(0 75%,  100% 75%,  100% 90%, 0 90%); }
  }

  /* ---- Eyebrow + subtitle ---- */
  .hero-eyebrow {
    font-size: 0.55rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.3em;
    margin-bottom: 2rem;
    animation: fadeUp 1.2s ease 0.2s both;
  }

  .hero-subtitle {
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 2vw, 1rem);
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.1em;
    margin-bottom: 3rem;
    animation: fadeUp 1.2s ease 0.6s both;
  }

  /* ---- Scroll instructions ---- */
  .hero-instructions {
    font-family: 'Science Gothic', sans-serif;
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    animation: fadeUp 1.2s ease 0.8s both;
    color: rgba(255, 255, 255, 1);
  }

  /* ---- Keyframes ---- */
  @keyframes crt-on {
    0%   { clip-path: inset(50% 0 50% 0); opacity: 0.8; }
    15%  { clip-path: inset(40% 0 40% 0); opacity: 1; }
    40%  { clip-path: inset(15% 0 15% 0); }
    70%  { clip-path: inset(3% 0 3% 0); }
    100% { clip-path: inset(0% 0 0% 0); }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes flicker {
    0%   { opacity: 0.03; }
    5%   { opacity: 0.05; }
    15%  { opacity: 0.06; }
    25%  { opacity: 0.02; }
    40%  { opacity: 0.04; }
    55%  { opacity: 0.02; }
    70%  { opacity: 0.05; }
    85%  { opacity: 0.03; }
    100% { opacity: 0.04; }
  }

  @keyframes textShadow {
    0%   { text-shadow: 0.4px  0 1px rgba(0,30,255,0.2), -0.4px  0 1px rgba(255,0,80,0.15), 0 0 3px; }
    20%  { text-shadow: 3.5px  0 1px rgba(0,30,255,0.2), -3.5px  0 1px rgba(255,0,80,0.15), 0 0 3px; }
    40%  { text-shadow: 3.9px  0 1px rgba(0,30,255,0.2), -3.9px  0 1px rgba(255,0,80,0.15), 0 0 3px; }
    60%  { text-shadow: 2.2px  0 1px rgba(0,30,255,0.2), -2.2px  0 1px rgba(255,0,80,0.15), 0 0 3px; }
    80%  { text-shadow: 0.5px  0 1px rgba(0,30,255,0.2), -0.5px  0 1px rgba(255,0,80,0.15), 0 0 3px; }
    100% { text-shadow: 2.6px  0 1px rgba(0,30,255,0.2), -2.6px  0 1px rgba(255,0,80,0.15), 0 0 3px; }
  }
</style>

<script>
  const el = document.querySelector('.glitch-suffix') as HTMLElement;
  if (!el) throw new Error("Glitch element not found");
  const real = el.dataset.real;
  const fake = el.dataset.fake;

  function runGlitch() {
    el.setAttribute('data-current', fake!);
    el.textContent = fake!;
    el.classList.add('is-glitching');

    setTimeout(() => {
      el.setAttribute('data-current', real!);
      el.textContent = real!;
      el.classList.remove('is-glitching');
    }, 2500);
  }

  setTimeout(runGlitch, 3000);
  setInterval(runGlitch, 10000);
</script>
